{
  "name": "@ventisca/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor autoritativo de Ventisca en línea: sirve el juego, la API y las partidas (D-37).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@ventisca/core": "workspace:*",
    "@ventisca/protocol": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
