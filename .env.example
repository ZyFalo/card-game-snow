# Variables de entorno de Ventisca. Copia este archivo a .env (que git ignora) y ajústalo:
#   cp .env.example .env
# En Railway no se usa .env: las variables se cargan en el panel del servicio (paso 4 del M7).
# Aquí solo van valores de ejemplo para desarrollo; nunca pongas secretos reales en este archivo.

# --- Base de datos (desde el PR 3) ---
# Postgres de desarrollo, el de `docker compose up -d db` (en el puerto 5434). En Railway la da su Postgres.
DATABASE_URL=postgres://ventisca:ventisca@localhost:5434/ventisca
# Solo para `pnpm test`: un servidor donde las pruebas puedan crear y borrar bases temporales.
# Sin esta variable, las pruebas del servidor que usan Postgres se saltan.
DATABASE_URL_TEST=postgres://ventisca:ventisca@localhost:5434/postgres

# --- Servidor (desde el PR 3) ---
# Railway define PORT por su cuenta; en desarrollo, 3000.
PORT=3000
# fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# --- Cuentas (desde el PR 5; todavía no se leen) ---
# Firma las cookies de sesión. En producción: 32 bytes aleatorios o más, por ejemplo con
#   openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo
# Dirección pública del juego, para los correos. En producción: https://ventisca.wpena.dev
APP_URL=http://localhost:3000

# --- Correo (desde el PR 6; todavía no se lee) ---
# Clave de Resend. Vacía en desarrollo: los correos se escriben en el registro del servidor.
RESEND_API_KEY=
