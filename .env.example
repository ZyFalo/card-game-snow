# Variables de entorno de Ventisca. Copia este archivo a .env (que git ignora) y ajústalo:
#   cp .env.example .env
# En Railway no se usa .env: las variables se cargan en el panel del servicio (paso 4 del M7).
# Aquí solo van valores de ejemplo para desarrollo; nunca pongas secretos reales en este archivo.

# --- Base de datos (desde el PR 3) ---
# Postgres de desarrollo, el de `docker compose up -d db` (en el puerto 5434). En Railway la da su Postgres.
DATABASE_URL=postgres://ventisca:ventisca@localhost:5434/ventisca
# Solo para `pnpm test`: un servidor donde las pruebas puedan crear y borrar bases temporales.
# Sin esta variable, las pruebas del servidor que usan Postgres se saltan.
DATABASE_URL_TEST=postgres://ventisca:ventisca@localhost:5434/postgres

# --- Servidor (desde el PR 3) ---
# Railway define PORT por su cuenta; en desarrollo, 3000.
PORT=3000
# fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# --- Cuentas (desde el PR 5) ---
# Clave de las huellas HMAC de las sesiones y de los códigos por correo; al menos 32 caracteres.
# En producción la genera el dueño con `openssl rand -base64 48` y la carga en Railway.
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo
# Dirección pública del juego, sin barra final: va en los correos, y con https la cookie de sesión es
# Secure. En producción: https://ventisca.wpena.dev
APP_URL=http://localhost:3000

# --- Correo (desde el PR 6) ---
# Clave de Resend, con permiso solo de envío y restringida a ventisca.wpena.dev. Vacía en desarrollo:
# los correos se imprimen en la consola del servidor. En producción la carga el dueño en Railway.
RESEND_API_KEY=

# --- Captcha del registro (desde el PR 6) ---
# Claves de prueba públicas de Cloudflare Turnstile: siempre pasan. En producción, las reales van en
# Railway; la del sitio es pública y la entrega GET /api/config.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
